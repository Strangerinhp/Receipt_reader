# Choose: sqlserver or sqlite
DATABASE_ENGINE=sqlserver

# SQLite trial alternative:
# DATABASE_ENGINE=sqlite
# SQLITE_DATABASE_PATH=./backend/data/invoice_ocr.db

# Windows authentication (recommended for local SQL Server)
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=InvoiceOCR;Trusted_Connection=yes;TrustServerCertificate=yes

# SQL authentication alternative
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=InvoiceOCR;UID=invoice_app;PWD=change-me;Encrypt=yes;TrustServerCertificate=yes

AUTO_INIT_DB=true
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=25
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional OCR experiments; restart the backend after changing these values.
# PDF render resolution, 150-600 DPI; default 300.
OCR_PDF_DPI=300
# 170 keeps the existing watermark filter; 0 preserves grayscale for faint accents.
OCR_BINARIZE_THRESHOLD=170
